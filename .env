# URL pública del frontend; se usa para construir el link de consulta en el Código QR del comprobante
FRONTEND_URL="http://localhost:4300/consulta-comprobante"

# Orígenes permitidos por CORS (Asegúrate de usar comillas simples por fuera y dobles por dentro para el JSON)
CORS_ALLOWED_ORIGINS='["http://localhost:81", "http://localhost:4300", "http://127.0.0.1:81", "http://127.0.0.1:4300", "http://192.168.18.18:81"]'

API_URL=http://192.168.1.50:8001

PYTHONPATH=/app