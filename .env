# Configuración General
APP_NAME="Novus ERP Modular"
DEBUG=True

# Credenciales de Base de Datos (Mismas que lee el contenedor postgres)
POSTGRES_USER=novus
POSTGRES_PASSWORD=dev_secret_change_me
POSTGRES_DB=novus
POSTGRES_HOST=novus-db
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --locale=en_US.UTF-8

# URLs de Conexión (Lo que lee FastAPI y Celery)
# Nota: Usamos 'db' en lugar de localhost para que resuelva en la red de Docker
DATABASE_URL=postgresql+asyncpg://novus:dev_secret_change_me@novus-db:5432/novus

# Redis y Celery (Usamos el host 'redis' del docker-compose)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT — Cambiar JWT_SECRET_KEY por un valor seguro antes de producción
JWT_SECRET_KEY=dev_jwt_secret_empower_erp_2026_cambiar_en_prod
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Token para consultar RUC y DNI 
APISPERU_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJlbWFpbCI6ImhjdW1iaWN1c3JAZ21haWwuY29tIn0.rMxHSxuVWrvSaau3nDyCq3kRbaoQHjjW9D1khYzU5kE

